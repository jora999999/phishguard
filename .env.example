# PhishGuard AI — configuration d'environnement
# Copiez ce fichier vers .env (jamais commité) : cp .env.example .env

# === DÉVELOPPEMENT ===
# En développement local, laissez les valeurs par défaut.
# Vite (port 5173) proxifie /api vers le backend (port 8000).

# === PRODUCTION ===
# Sur votre plateforme, définissez ces variables comme secrets :

# Clé Gemini API (Free Tier) — OPTIONNELLE mais recommandée.
# Sans clé, l'application fonctionne entièrement avec le moteur de règles local.
# Obtenez une clé gratuite (sans carte de crédit) sur https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# URL du backend vue par React/frontend.
# En dev local : inutile (proxy Vite).
# En prod : https://api.example.com ou http://backend:8000 (Docker).
VITE_API_URL=http://localhost:8000

# Origines autorisées pour CORS (comma-separated).
# En dev : localhost:5173
# En prod : https://example.com,https://www.example.com
FRONTEND_URL=http://localhost:5173

# Modèle Gemini (optionnel, défaut : gemini-2.5-flash — inclus dans le Free Tier)
# GEMINI_MODEL=gemini-2.5-flash
